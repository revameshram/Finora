# ==============================================================================
# Finora Environment Variables (Local / Supabase)
# ==============================================================================

# Database Configuration (Supabase PostgreSQL / Direct Connection or Transaction Pooler)
# Direct connection: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or Transaction pooler (Port 6543) / Session pooler (Port 5432)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/finora_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Supabase API Settings (Optional client-side / service keys)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Authentication Secret (Minimum 256 bits / 32 bytes for HMAC-SHA256)
FINORA_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
FINORA_JWT_EXPIRATION_MS=86400000

# Server Port
PORT=8080
VITE_API_URL=http://localhost:8080/api/v1
